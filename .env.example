# Токен бота от @BotFather (обязательно)
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Какое расписание отслеживать. Берётся из ссылки:
# https://site.mstimetables.ru/<PUBLICATION_ID>/groups/<GROUP_ID>
PUBLICATION_ID=01a00f53-d327-73b5-b396-bf3eb6f57ce2
GROUP_ID=304
SCHEDULE_BASE_URL=https://site.mstimetables.ru

# Часовой пояс колледжа
TIMEZONE=Europe/Moscow

# Как часто проверять изменения (минуты)
CHECK_INTERVAL_MIN=20
# Во сколько присылать утреннюю сводку
MORNING_TIME=07:30
# За сколько минут до пары напоминать
REMIND_BEFORE_MIN=15
# На сколько дней вперёд следить за изменениями
TRACK_DAYS=14

# Файл базы данных SQLite (на Railway укажите путь внутри Volume, например /data/schedule.db)
DB_PATH=schedule.db
